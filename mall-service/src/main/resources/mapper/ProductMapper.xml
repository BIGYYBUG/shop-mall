<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.ProductMapper">

    <!--
      ============================================================================
      库存扣减：一条 SQL 同时完成「加锁 + 校验 + 更新」
      ============================================================================

      ⚠ 校验条件必须写在 WHERE 里，绝不能写成"先查后改"
      ============================================================================
      错误写法（超卖的经典成因）：

          ProductEntity p = productMapper.selectById(id);        // 两个线程都读到 stock = 1
          if (p.getStock() >= quantity) {                        // 两个线程都判定"够"
              productMapper.updateById(p.setStock(p.getStock() - quantity));  // 都减 1
          }

      结果：库存 1 件，卖出 2 件。

      正确写法把判断交给数据库：InnoDB 对 id 这一行做【当前读】并加排他锁，
      并发的第二个事务会阻塞到第一个提交，然后重新读取最新 stock 再判断条件，
      条件不成立则 affected = 0。判断和更新之间不存在任何可被插入的窗口。

      ⚠ 为什么用 affected rows 而不是再查一次库存来判定
      ============================================================================
      再查一次是"两次网络往返 + 一个可被并发改变的中间态"；affected rows 是
      数据库在行锁内给出的确定性结论，是这一个动作的原子结果，更便宜也更准确。

      ⚠ status = 1 AND deleted = 0 是必须的
      ============================================================================
      这两个条件保证"已下架 / 已删除的商品不会被买走"。
      手写 XML 不走 @TableLogic 的自动改写，deleted = 0 必须自己写 ——
      漏写的后果是已删除商品仍可下单，属于静默越权。
    -->
    <update id="deductStock">
        UPDATE mall_product
        SET stock = stock - #{quantity}
        WHERE id = #{productId}
          AND status = 1
          AND deleted = 0
          AND stock &gt;= #{quantity}
    </update>

    <!--
      ============================================================================
      库存回补（取消 / 超时关单）
      ============================================================================

      ⚠ 刻意不判断 status 与 deleted
      ============================================================================
      "用户没买成、货得还回去"与商品当前是否上架、是否被删无关。
      若加上 status = 1，就会出现"因为商品已下架，这批库存再也补不回来"——
      错误的条件让回补变成一个会静默失败的副作用。

      ⚠ 调用前必须已经 CAS 成功把订单置为已取消
      ============================================================================
      否则这个 + 会被执行两次，库存凭空增加。顺序是：
          1. UPDATE mall_order ... AND status = 0   → affected 必须为 1
          2. 再回补库存
      反过来写（先补库存再改状态）在并发取消时必然重复回补。
    -->
    <update id="restoreStock">
        UPDATE mall_product
        SET stock = stock + #{quantity}
        WHERE id = #{productId}
    </update>

    <!--
      ============================================================================
      销量累加
      ============================================================================

      只在【支付成功】时调用。销量语义上单调递增，下单就加、取消就减会让它
      退化成"当前有效订单件数"，且数值会回退，对外展示自相矛盾。
    -->
    <update id="increaseSales">
        UPDATE mall_product
        SET sales = sales + #{quantity}
        WHERE id = #{productId}
    </update>

</mapper>
